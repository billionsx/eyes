# Склад ключуется адресом — у столкновения есть правильный ответ, и это
# ОБЪЕДИНЕНИЕ, а не «чей-то победил». Драйвер объявляется в bin/chronicle.sh.
registry/corpus/**/*.jsonl.gz merge=corpusunion
registry/corpus/**/*.jsonl.gz -diff
# Склад жатвы и порождённые своды — БИНАРНЫЕ и переписываются целиком каждым
# прогоном работника. Слияние их построчно бессмысленно и всегда даёт
# конфликт: при расхождении верна СВЕЖАЯ версия, а не склеенная.
registry/corpus/hig/*.jsonl.gz binary merge=ours
